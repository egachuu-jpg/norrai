      "typeVersion": 2.5,
      "position": [480, 180],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT COALESCE(\n  (SELECT json_build_object('client_id', id, 'enabled_tools', enabled_tools)\n   FROM clients\n   WHERE primary_contact_email = '{{ String($json.body.agent_email || '').replace(/'/g, \"''\") }}'\n   LIMIT 1),\n  json_build_object('client_id', null)\n) AS result",
        "options": {}
      },
      "credentials": {
        "postgres": { "id": "2DDeKGMIP9Ijbd9R", "name": "Postgres account" }
      }
    },
